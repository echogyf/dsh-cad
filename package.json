{
  "name": "dsh-cad",
  "version": "2.0.0",
  "description": "Drives the installed AutoCAD desktop app from dsh or Codex using an isolated Python runtime, one skill and the upstream MCP server's search discovery.",
  "type": "module",
  "license": "MIT",
  "author": "27painter",
  "homepage": "https://github.com/echogyf/dsh-cad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echogyf/dsh-cad.git"
  },
  "bugs": {
    "url": "https://github.com/echogyf/dsh-cad/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "autocad",
    "cad",
    "com",
    "windows",
    "ai-agent"
  ],
  "bin": {
    "dsh-cad": "bin/dsh-cad.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "docs/",
    "assets/",
    "patches/",
    "cordis.patch.yml",
    "bootstrap.ps1",
    "install.ps1",
    "codex-config.snippet.toml",
    "README.md",
    "LICENSE",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2"
  },
  "scripts": {
    "check": "node bin/dsh-cad.mjs doctor",
    "test": "node --test test/plugin.test.mjs test/python.test.mjs test/runtime.test.mjs",
    "test:ps": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File test/powershell.test.ps1"
  }
}
